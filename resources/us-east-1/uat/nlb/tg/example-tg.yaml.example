# Copy to <service>.yaml to expose a service on the NLB. Every key not
# stated here falls back to target_group_defaults in ../config.yaml -
# except health_check, which replaces the whole map (shallow merge):
# restate every health_check key you keep. listener has no defaults.
#
# Terraform creates the target group EMPTY. The pods join it via a
# TargetGroupBinding shipped with the app's Flux release - see ../README.md
# for the manifest and where to find the ARN.
name: istio-ingress
port: 8443 # the containerPort pods actually listen on (ip targets - no NodePort hop)
protocol: TCP # TCP / UDP / TCP_UDP - must be compatible with listener.protocol

# An NLB listener has no rules: this port forwards to this target group
# and nothing else, so listener ports must be unique across tg/ files.
listener:
  port: 443
  protocol: TCP # TCP / UDP / TCP_UDP, or TLS (terminates with certificate_domain in ../config.yaml)
  # alpn_policy: HTTP2Preferred # TLS only; default None

health_check:
  protocol: HTTP # TCP only probes the port; HTTP/HTTPS also check path + matcher
  port: "15021"  # a port number must be quoted (or traffic-port)
  path: /healthz/ready
  matcher: "200-399"
  interval: 10
  timeout: 5
  healthy_threshold: 2
  unhealthy_threshold: 2
