# Extra security group for the cluster - one SELF-CONTAINED file per group
# (template format: rules are MAPS keyed by rule name; security_group_defaults
# is gone from config.yaml). attach_to_cluster: true adds the group to the
# EKS control plane ENIs. A rule's sources are cidrs and/or
# referenced_security_group_ids (this environment's VPC CIDR is in
# network/config.yaml). Omitted from_port/to_port/ip_protocol = all
# traffic (like default_ipv4 below).
# Inactive while it ends in .example - copy, drop the suffix, adjust.
name: cluster-internal # deployed as <cluster>-cluster-internal
description: HTTPS to the cluster API from inside the VPC
attach_to_cluster: true

ingress_rules:
  https-from-vpc:
    description: HTTPS from the VPC
    from_port: 443
    to_port: 443
    ip_protocol: tcp
    cidrs:
      - 10.3.0.0/16 # this environment's VPC CIDR
    # referenced_security_group_ids: # source by SG id instead of/besides CIDRs
    #   - sg-xxxxxx

egress_rules:
  default_ipv4: # no ports/protocol stated = all traffic
    cidrs:
      - 0.0.0.0/0
  # default_ipv6: # not wired - the VPC is IPv4-only, an IPv6 rule would match nothing
  #   cidrs_ipv6:
  #     - ::/0

tags: # extra per-group tags (Org/Env/... come from default_tags)
  cluster-name: prod-eks-us-east-1
